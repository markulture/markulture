---
import { getEntry } from 'astro:content';
const footer = await getEntry('settings', 'footer');
---

<!-- Footer Section -->
<footer class=" text-white">
  {footer && footer.data.bodyVisual && (
    <div set:html={footer.data.bodyVisual} />
  )}
</footer>


<script>
  (function () {
    try {
      const btn = document.getElementById('back-to-top');
      if (!btn) return;

      const showAfter = 300; // pixels

      function onScroll() {
        if (window.scrollY > showAfter) {
          btn.style.display = 'block';
          btn.style.opacity = '1';
        } else {
          btn.style.opacity = '0';
          btn.style.display = 'none';
        }
      }

      // Show/hide on scroll
      window.addEventListener('scroll', onScroll, { passive: true });

      // Click to scroll to top smoothly
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // Initial check
      onScroll();
    } catch (err) {
      console.warn('Back to top script failed', err);
    }
  })();
</script>